# Resend — contact form (Server Action)
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify a domain at https://resend.com/domains (recommended: jonasmessias.dev.br)
#    Until the domain is verified, you can only send to your own Resend account email.
RESEND_API_KEY=

# Sender must be an address on a VERIFIED domain (e.g. contato@jonasmessias.dev.br).
# For quick testing before verifying a domain, you can use: onboarding@resend.dev
CONTACT_FROM_EMAIL=contato@jonasmessias.dev.br

# Where contact submissions are delivered.
CONTACT_TO_EMAIL=jonasmessias30@gmail.com
